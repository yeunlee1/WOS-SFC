# 서버 설정. server/.env로 복사한 뒤 빈 값을 채웁니다.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# 엔티티 기반 자동 테이블 생성. 폐기 가능한 로컬 개발 DB에서만 true 로 켜십시오.
# 운영(NODE_ENV=production)에서는 값과 무관하게 항상 꺼집니다 — 데이터 손실 방지.
# 운영 스키마는 `npm run migrate` 가 server/migrations/*.sql 을 적용해 만듭니다.
TYPEORM_SYNC=false

JWT_SECRET=
SERVER_CODE=

# 선택 기능 설정.
ANTHROPIC_API_KEY=
# 카운트다운 음성. 첫 배포는 tts-cache 볼륨이 비어 있어 이 키가 없으면 음성이 전혀 나오지 않는다.
# 키 없이 쓰려면 개발 PC 의 server/tts-cache(mp3 + cache.meta.json)를 볼륨에 먼저 옮긴다(README 첫 배포 체크리스트).
GOOGLE_TTS_API_KEY=
TTS_CACHE_DIR=

# 채팅 메시지 보존 일수. 기본은 비활성(빈 값) — 아무것도 삭제하지 않습니다.
# 경고: 값을 넣으면 서버 기동 60초 뒤부터 6시간마다 그 일수 이전 메시지가
#       DB에서 자동 삭제되기 시작합니다. 되돌릴 수 없습니다.
#       1 이상의 정수만 유효하며 그 외(0, 음수, 소수, 문자)는 비활성 처리됩니다.
#       켜기 전에 `npm run migrate` 로 마이그레이션을 적용하세요
#       (003_messages_created_at_index.sql 의 인덱스가 있어야 정리 쿼리가 느려지지 않습니다).
CHAT_RETENTION_DAYS=

# 프론트엔드 설정. VITE_API_TARGET은 셸 환경변수로 전달합니다.
VITE_API_TARGET=http://localhost:3001
VITE_API_URL=/

# =============================================================================
# Docker 배포 전용 설정 (docker-compose.yml 이 읽습니다)
# =============================================================================
# 이 파일은 두 곳에 복사해 씁니다.
#   - 로컬 개발: server/.env
#   - Docker 배포: 저장소 루트의 .env  (compose 가 ${...} 치환에 이 파일을 씁니다)
# 아래 항목은 Docker 배포에서만 필요합니다. 값은 절대 커밋하지 마십시오.
#
# 값 규칙 — $ # 따옴표 공백을 넣지 마십시오(compose 치환에서 깨집니다). 비밀값은 `openssl rand -hex 32`.
# WEB_ORIGIN — 위쪽 항목을 브라우저가 실제로 여는 주소로 바꾸십시오. https 스킴, SITE_ADDRESS 와 같은
#   호스트, 끝 슬래시 없음. 예: https://203.0.113.10.sslip.io  (서버가 부팅 시 끝 슬래시를 정리하고
#   localhost 가 남아 있으면 경고를 남깁니다. JWT_SECRET 32자 미만·SERVER_CODE 비어 있음은 부팅 거부.)

# MySQL 컨테이너의 root 비밀번호. 앱은 쓰지 않고 DB 초기화와 백업·복구에만 씁니다.
# 위쪽 DATABASE_PASSWORD(앱 계정)와 다른 값을 넣으십시오.
DATABASE_ROOT_PASSWORD=

# TypeORM 커넥션 풀 크기. 비우면 앱이 20을 씁니다(server/src/app.module.ts).
# DB 의 max_connections 를 넘기지 마십시오.
DATABASE_POOL_SIZE=

# 앞단 프록시 중 신뢰할 홉 수. 이 compose 구성에서는 1입니다.
#
# 이게 무엇인가 —
#   앱은 요청 한도(로그인·가입·토큰갱신 등)를 "누가 보냈는가"로 셉니다.
#   프록시 뒤에서는 앱이 보는 상대가 항상 프록시라, 진짜 클라이언트 주소는
#   X-Forwarded-For 헤더에만 남습니다. 이 값은 그 헤더에서 **뒤에서 몇 번째까지를
#   믿을 것인가**를 정합니다. 실제 프록시 단 수와 정확히 같아야 합니다.
#
# 왜 1인가 —
#   브라우저 → Caddy(proxy) → 앱  으로 앱 앞에 프록시가 정확히 한 단만 있습니다.
#   Caddy 의 reverse_proxy 가 X-Forwarded-For 를 붙이고, 앱과 직접 TCP 연결을 맺는
#   상대도 Caddy 하나뿐입니다.
#   비우면 server/src/common/trust-proxy.ts 가 production 기본값 1 로 떨어져 결과는
#   같지만, 부팅 로그에 "설정되지 않았다" 경고가 남으므로 명시하는 편을 권합니다.
#
# 틀리면 무슨 일이 생기는가 (양쪽 다 위험합니다) —
#   [너무 작게 잡으면] 접속자 전원의 IP 가 프록시 주소 하나로 잡힙니다.
#     동시 접속 100명이 로그인·토큰갱신 요청 한도를 **하나의 버킷으로 공유**하므로
#     한 사람이 한도를 채우면 나머지가 전부 429 로 막히고, 작전 중 강제 로그아웃됩니다.
#   [너무 크게 잡으면] 클라이언트가 직접 넣은 X-Forwarded-For 항목까지 신뢰하게 됩니다.
#     공격자가 헤더 한 줄로 요청마다 새 IP 를 만들어 한도를 **무제한 우회**합니다.
#     특히 **로그인 무차별 대입 방어가 통째로 무력화됩니다** — 계정 단위 게이트가
#     "이 계정에 이 IP 가 시도한 적 있는가" 기록에 의존하는데, 매 요청 새 IP 를 지어내면
#     항상 "처음 보는 IP" 가 되어 첫 시도가 계속 통과합니다.
#
# 값을 모를 때 확인하는 방법 —
#   서버가 부팅 후 **첫 5건**의 요청에 대해 X-Forwarded-For 체인, req.ip, 현재 홉 수,
#   그리고 권장 값을 **서버 로그에만** 남깁니다. HTTP 응답으로는 아무것도 나가지 않습니다.
#   배포 직후 아래를 실행하고 [trust proxy 진단] 줄의 "체인 길이"를 그대로 넣으십시오.
#     docker compose logs app | grep "trust proxy"
#   표본 5건을 다 채우면 멈추므로, 다시 재려면 앱을 재시작하십시오.
#   (컨테이너 헬스체크는 루프백에서 X-Forwarded-For 없이 들어오므로 표본에서 제외됩니다.
#    표본을 잡아먹지 않습니다.)
#
# 언제 바꾸는가 —
#   앞에 CDN 이나 클라우드 로드밸런서를 한 단 더 두면 2입니다(예: Cloudflare + Caddy).
#   ⚠ 그때는 홉 수만 올려서는 안 되고 deploy/Caddyfile 의 trusted_proxies 도 함께
#     켜야 합니다. Caddy 는 신뢰하지 않는 상대가 보낸 X-Forwarded-For 를 기본적으로
#     버리므로, 설정하지 않으면 CDN 의 IP 가 클라이언트로 기록되고 진짜 클라이언트 IP 는
#     영구히 유실됩니다. 이 상태는 진단 로그도 '정상'으로 판정하니 잡히지 않습니다.
#   PaaS(Fly/Railway/Render)처럼 플랫폼 라우터가 앞에 붙는 경우도 단 수가 달라집니다.
#   실제 단 수보다 크게 잡으면 위 위조 경로가 열리므로 반드시 실측한 값만 넣으십시오.
#   (trust-proxy.ts 는 0~8 의 정수만 받고 그 밖의 값은 조용히 기본값으로 되돌립니다.
#    되돌아간 경우 부팅 로그에 "해석할 수 없어 무시했다" 경고가 남습니다.)
TRUST_PROXY_HOPS=1

# Caddy 가 수신할 주소. 이 값 하나로 HTTPS 여부가 갈립니다.
#   - 비우면      : :80 (평문 HTTP). 기동 확인(docker compose ps, curl /time)에만 쓸 수 있습니다.
#                   secure 쿠키와 CSP 때문에 브라우저에서는 로그인도 화면도 동작하지 않습니다.
#                   도메인이 없으면 <IP>.sslip.io 처럼 IP 기반 도메인을 넣으십시오(README 2-A).
#                   IP 를 직접 넣으면 자체서명 인증서가 되므로 넣지 마십시오.
#   - 도메인 입력 : sfc.example.com  → Let's Encrypt 인증서를 자동 발급하고
#                   80 → 443 리다이렉트까지 Caddy 가 알아서 겁니다.
#                   그 도메인의 A/AAAA 레코드가 이 서버를 가리켜야 하고
#                   80·443 포트가 인터넷에서 열려 있어야 합니다.
SITE_ADDRESS=

# 호스트에 노출할 프록시 포트. 검증용이나 포트 충돌 회피에만 바꾸십시오.
# 자동 HTTPS 를 쓰려면 80·443 그대로여야 합니다(Let's Encrypt 검증이 그 포트를 씁니다).
HTTP_PORT=80
HTTPS_PORT=443

# 컨테이너 기동 시 실행할 마이그레이션 명령.
# 비우면 `npm run migrate` 를 씁니다. 이 명령이 실패하면 앱은 뜨지 않습니다.
# 스크립트 이름이 다르면 여기서 바꾸십시오. 예: npm run migration:run
# 마이그레이션 없이 띄워야 하면 true 를 넣으십시오(셸 no-op).
MIGRATE_CMD=

# 앱이 DB 접속을 기다릴 최대 시간(초). 비우면 120입니다.
DB_WAIT_TIMEOUT_SEC=
