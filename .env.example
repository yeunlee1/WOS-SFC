# 서버 설정. server/.env로 복사한 뒤 빈 값을 채웁니다.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
TYPEORM_SYNC=false

JWT_SECRET=
SERVER_CODE=

# 선택 기능 설정.
ANTHROPIC_API_KEY=
GOOGLE_TTS_API_KEY=
TTS_CACHE_DIR=

# 채팅 메시지 보존 일수. 기본은 비활성(빈 값) — 아무것도 삭제하지 않습니다.
# 경고: 값을 넣으면 서버 기동 60초 뒤부터 6시간마다 그 일수 이전 메시지가
#       DB에서 자동 삭제되기 시작합니다. 되돌릴 수 없습니다.
#       1 이상의 정수만 유효하며 그 외(0, 음수, 소수, 문자)는 비활성 처리됩니다.
#       켜기 전에 server/migrations/003_messages_created_at_index.sql 을 먼저 적용하세요.
CHAT_RETENTION_DAYS=

# 프론트엔드 설정. VITE_API_TARGET은 셸 환경변수로 전달합니다.
VITE_API_TARGET=http://localhost:3001
VITE_API_URL=/
