# 서버 설정. server/.env로 복사한 뒤 빈 값을 채웁니다.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
TYPEORM_SYNC=false

JWT_SECRET=
SERVER_CODE=

# 선택 기능 설정.
ANTHROPIC_API_KEY=
GOOGLE_TTS_API_KEY=
TTS_CACHE_DIR=

# 프론트엔드 설정. VITE_API_TARGET은 셸 환경변수로 전달합니다.
VITE_API_TARGET=http://localhost:3001
VITE_API_URL=/
